{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "lib": ["ESNext", "DOM"],
        "types": ["vendetta-types"]
    },
    "include": ["src"]
}
